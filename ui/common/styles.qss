QMainWindow, QDialog { background: #FFFFFF; color: #2B2B2B; }
QWidget { background: #FFFFFF; color: #2B2B2B; font-family: "Poppins"; font-size: 13px; }

#Title { font-family: "Playfair Display"; font-size: 20px; font-weight: bold; color: #C21A1F; padding: 2px; }

/* Categorías */
#CategoryButton {
    background: #FFFFFF; color: #C21A1F; border: 1px solid #C21A1F;
    border-radius: 10px; font-size: 13px; font-weight: bold; padding: 6px 10px;
}
#CategoryButton:checked { background: #C21A1F; color: #FFFFFF; }
#CategoryButton:checked:hover { background: #C21A1F; }

/* Scroll de categorías */
#CategoryScroll { background: transparent; }
QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 2px 6px 0 6px;
}
QScrollBar::handle:horizontal {
    background: #E8C9CB; border-radius: 4px; min-width: 48px;
}
QScrollBar::handle:horizontal:hover { background: #C21A1F; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; height: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QScrollBar:vertical {
    background: transparent; width: 10px; margin: 6px 2px 6px 0;
}
QScrollBar::handle:vertical {
    background: #E8C9CB; border-radius: 4px; min-height: 48px;
}
QScrollBar::handle:vertical:hover { background: #C21A1F; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { width: 0; height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

/* Productos */
#ProductCard { background: #FFFFFF; border: 1px solid #E8C9CB; border-radius: 12px; }
#ProductCard:hover { border: 1px solid #C21A1F; }
#ProductCard[soldOut="true"] { background: #F0EDEB; border: 1px solid #DDDDDD; }
#ProductCard[soldOut="true"] #ProductName { color: #9A9A9A; }
#ProductImage { background: #EFE9E6; border-radius: 8px; color: #A59B97; font-size: 12px; }
#ProductName { font-size: 12px; font-weight: bold; }
#ProductPrice { font-size: 15px; font-weight: bold; color: #C21A1F; }
#SoldOutLabel { font-size: 13px; font-weight: bold; color: #9A9A9A; }
#EmptyLabel { font-size: 16px; color: #9A9A9A; padding: 30px; }

/* Carrito */
#CartPanel { background: #FFFFFF; border: 1px solid #E8C9CB; border-radius: 12px; }
#CartTitle {
    background: #C21A1F; color: #FFFFFF; font-size: 15px; font-weight: bold;
    padding: 8px; border-radius: 8px;
}
#CartRow { font-size: 12px; }
#CartTotal { font-size: 20px; font-weight: bold; color: #C21A1F; padding: 4px 2px; }
#CartNote { color: #B26A00; font-size: 12px; padding: 2px; }
#QtyButton {
    background: #FFFFFF; color: #C21A1F; border: 1px solid #C21A1F;
    border-radius: 18px; font-size: 16px; font-weight: bold;
}
#QtyButton:pressed { background: #F6DADB; }
#ConfirmButton {
    background: #C21A1F; color: #FFFFFF; border: none;
    border-radius: 10px; font-size: 15px; font-weight: bold; padding: 6px;
}
#ConfirmButton:pressed { background: #8E1116; }
#ConfirmButton:disabled { background: #D9C9CA; color: #FFFFFF; }
#ClearButton {
    background: transparent; color: #C21A1F; border: 1px solid #C21A1F;
    border-radius: 10px; padding: 8px; font-weight: bold; font-size: 13px;
}
#ClearButton:disabled { color: #CDB9BA; border-color: #E5D5D6; }

/* Ticket */
#TicketTitle { font-family: "Playfair Display"; font-size: 24px; font-weight: bold; color: #C21A1F; padding: 6px; }
#TicketNumber { font-size: 48px; font-weight: bold; color: #C21A1F; }
#TicketPreview {
    background: #FFFFFF; color: #2B2B2B; border: 1px dashed #C9B8B9; border-radius: 8px;
    padding: 12px; font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 13px;
}

/* Adiciones */
#AddonTitle { font-family: "Playfair Display"; font-size: 18px; font-weight: bold; color: #C21A1F; }
#AddonSub { color: #6B6B6B; padding-bottom: 2px; font-size: 13px; }
#AddonCheck { font-size: 14px; padding: 6px 4px; spacing: 10px; }
#AddonCheck::indicator { width: 24px; height: 24px; border: 2px solid #C21A1F; border-radius: 6px; background: #FFFFFF; }
#AddonCheck::indicator:checked { background: #C21A1F; }
#AddonCheck:disabled { color: #9A9A9A; }
#AddonCheck::indicator:disabled { border-color: #CCCCCC; background: #F0EDEB; }
#AddonTotal { font-size: 18px; font-weight: bold; color: #C21A1F; padding: 2px 0; }

/* Panel de impresora */
#SetupCombo, #SetupInput {
    background: #FFFFFF; border: 1px solid #C21A1F; border-radius: 8px;
    padding: 6px 8px; font-size: 14px;
}
#SetupList {
    background: #FFFFFF; border: 1px solid #E8C9CB; border-radius: 8px;
    font-size: 13px; padding: 4px;
}
#SetupList::item { padding: 10px 6px; }
#SetupList::item:selected { background: #F6DADB; color: #C21A1F; }
#SetupNote { color: #B26A00; font-size: 13px; padding: 4px; }

/* Login de empleado */
#LoginDialog { background: #FAF6F5; }
#LoginCard {
    background: #FFFFFF; border: 1px solid #E8C9CB; border-radius: 14px;
}
#LoginTitle { font-family: "Playfair Display"; font-size: 24px; font-weight: bold; color: #C21A1F; padding: 2px; }
#LoginSubtitle { color: #6B6B6B; font-size: 14px; }
#LoginInput {
    background: #FFFFFF; border: 1px solid #C21A1F; border-radius: 10px;
    padding: 10px 12px; font-size: 14px; margin: 2px 0;
}
#LoginError { color: #C21A1F; font-size: 12px; padding: 2px; }
#LoginClose {
    background: transparent; border: none; color: #9A9A9A;
    font-size: 12px; padding: 6px; margin-top: 4px;
}
#LoginClose:hover { color: #C21A1F; }

/* Teclado táctil propio */
#TouchKeyboard { background: transparent; }
#KeyButton {
    background: #FFFFFF; color: #2B2B2B; border: 1px solid #E8C9CB;
    border-radius: 8px; font-size: 14px; font-weight: bold; padding: 2px;
}
#KeyButton:pressed { background: #F6DADB; color: #C21A1F; }
#KeyAction {
    background: #FFFFFF; color: #C21A1F; border: 1px solid #C21A1F;
    border-radius: 8px; font-size: 14px; font-weight: bold; padding: 2px;
}
#KeyAction:pressed { background: #F6DADB; }