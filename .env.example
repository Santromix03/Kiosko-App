SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_clave_anon_aqui
NOMBRE_LOCAL=Mi Restaurante
TICKET_WIDTH=32

# Impresora: bluetooth (impresora térmica por Bluetooth) o file (guarda PNG en tickets/)
# Si no se define, se usa bluetooth cuando PRINTER_MAC esté configurado.
PRINTER_MODE=bluetooth
# MAC de la impresora (la ves con: hcitool scan)
PRINTER_MAC=00:11:22:33:44:55
# Canal RFCOMM fijo; déjalo vacío para que pruebe del 1 al 10
PRINTER_CHANNEL=

# Modo kiosco: pantalla completa sin bordes (lo activa instalar_pi.sh)
KIOSK_FULLSCREEN=1
